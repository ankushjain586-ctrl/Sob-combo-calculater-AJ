<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Summary of SOB - Final</title>
<style>
body{margin:0;font-family:Arial,sans-serif;background:#fde8c0;padding:8px}
.header{background:#d68c2a;color:#000;padding:10px;text-align:center;font-weight:900;border:2px solid #000}
.table-box{background:#fff;border:2px solid #000;overflow:auto}
table{width:100%;border-collapse:collapse;font-size:11px}
th,td{border:1px solid #000;padding:6px 4px;text-align:center}
th{background:#f9c87c}
td input{width:55px;border:1px solid #888;border-radius:4px;padding:3px;text-align:center;font-size:12px}
.total-row{background:#fde8c0;font-weight:900}
.grand-row{background:#f9b84a;font-weight:900}
.footfall{background:#4a1a1a;color:#fff;padding:10px;border-radius:8px;text-align:center;font-weight:900;margin:10px 0}
.manual{background:#fff;border:2px solid #000;padding:10px;border-radius:8px;margin:10px 0}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.grid input{width:100%;box-sizing:border-box;border:1px solid #888;border-radius:6px;padding:7px}
.btns{display:flex;gap:6px;justify-content:center;margin:10px 0}
.btns button{border:none;padding:9px 16px;border-radius:20px;font-weight:bold;color:#fff;font-size:12px;cursor:pointer}
.gen{background:#0a7a1e} .copy{background:#1e5eff} .print{background:#ff6a00}
.report{background:#fff;padding:12px;border:2px solid #000;white-space:pre-wrap;font-family:monospace;font-size:12px;line-height:1.5}
@media print{.no-print{display:none}}
</style>
</head>
<body>
<div class="header">Summary of SOB</div>

<div class="table-box no-print" style="margin-top:8px">
<table>
<tr><th rowspan="2">DATE</th><th rowspan="2">PARTICULAR</th><th colspan="3">FOOTFALL (Nos)</th><th>MTD (Oct-26)</th></tr>
<tr><th>ADULT</th><th>CHILD</th><th>Total Footfall</th><th>Total Footfall</th></tr>
<tr><td rowspan="7"><input type="date" id="dateInput" style="width:110px"><br><span id="dateShow">22/10/2026</span></td>
<td style="text-align:left">PARK ENTRY</td><td><input type="number" id="pe_a" value="597"></td><td><input type="number" id="pe_c" value="77"></td><td id="pe_t">674</td><td><input type="number" id="pe_mtd" value="22231"></td></tr>
<tr><td style="text-align:left">270FT + 280FT</td><td><input type="number" id="ft_a" value="327"></td><td><input type="number" id="ft_c" value="42"></td><td id="ft_t">369</td><td><input type="number" id="ft_mtd" value="12876"></td></tr>
<tr><td style="text-align:left">JALAABHISHEK</td><td><input type="number" id="jal_a" value="0"></td><td><input type="number" id="jal_c" value="0"></td><td id="jal_t">0</td><td><input type="number" id="jal_mtd" value="81"></td></tr>
<tr><td style="text-align:left">EXPRESS TICKET</td><td><input type="number" id="exp_a" value="0"></td><td><input type="number" id="exp_c" value="0"></td><td id="exp_t">0</td><td><input type="number" id="exp_mtd" value="24"></td></tr>
<tr><td style="text-align:left">AATMA MANTHAN</td><td><input type="number" id="aatma_a" value="4"></td><td><input type="number" id="aatma_c" value="0"></td><td id="aatma_t">4</td><td><input type="number" id="aatma_mtd" value="561"></td></tr>
<tr><td style="text-align:left">AATMA M.,270FT+280FT</td><td><input type="number" id="amft_a" value="38"></td><td><input type="number" id="amft_c" value="5"></td><td id="amft_t">43</td><td><input type="number" id="amft_mtd" value="2104"></td></tr>
<tr><td style="text-align:left">AATMA M+ JALAABHISHEK</td><td><input type="number" id="amjal_a" value="0"></td><td><input type="number" id="amjal_c" value="0"></td><td id="amjal_t">0</td><td><input type="number" id="amjal_mtd" value="266"></td></tr>
<tr class="total-row"><td colspan="2" style="text-align:left">TOTAL PARK ENTRY</td><td id="tot_a">966</td><td id="tot_c">124</td><td id="tot_t">1090</td><td id="tot_mtd">38143</td></tr>
<tr class="grand-row"><td>22/10/2026</td><td colspan="2">COLLECTION DETAILS</td><td>PARTICULAR</td><td colspan="2">TICKET SALE (INR)</td></tr>
<tr><td></td><td colspan="2"></td><td>TOTAL</td><td colspan="2"><input type="number" id="collection" value="325535" style="width:90px"> <span id="collShow">325,535</span></td></tr>
</table>
</div>

<div class="footfall">TOTAL: <span id="bar_a">966</span> Adult + <span id="bar_c">124</span> Child = <span id="bar_t">1090</span> | MTD: <span id="bar_mtd">38143</span></div>

<div class="manual no-print">
<h3 style="margin:0 0 6px;font-size:12px">📝 Manual (WhatsApp Report ke liye)</h3>
<div class="grid">
<div><label style="font-size:10px">NAM Undertaking Form</label><input type="number" id="nam_form" value="1"></div>
<div><label style="font-size:10px">VG,NAA,NAM Form</label><input type="number" id="vgn_form" value="395"></div>
<div><label style="font-size:10px">Loyalty Card</label><input type="number" id="loyalty" value="60"></div>
<div><label style="font-size:10px">School Contact</label><input type="number" id="school" value="6"></div>
<div><label style="font-size:10px">Google Review</label><input type="number" id="google" value="2"></div>
<div><label style="font-size:10px">Video Feedback</label><input type="number" id="video" value="0"></div>
<div><label style="font-size:10px">Trip Advisors</label><input type="number" id="trip" value="2"></div>
</div>
</div>

<div class="btns no-print">
<button class="gen" onclick="generate()">✅ Generate Report</button>
<button class="copy" onclick="copyR()">📋 Copy WhatsApp Report</button>
<button class="print" onclick="window.print()">🖨️ Print</button>
</div>

<div class="report" id="report"></div>

<script>
function n(id){return parseInt(document.getElementById(id).value)||0}
function calc(){
 let pe_a=n('pe_a'),pe_c=n('pe_c'),ft_a=n('ft_a'),ft_c=n('ft_c'),jal_a=n('jal_a'),jal_c=n('jal_c'),exp_a=n('exp_a'),exp_c=n('exp_c'),aatma_a=n('aatma_a'),aatma_c=n('aatma_c'),amft_a=n('amft_a'),amft_c=n('amft_c'),amjal_a=n('amjal_a'),amjal_c=n('amjal_c');
 let pe_t=pe_a+pe_c, ft_t=ft_a+ft_c, jal_t=jal_a+jal_c, exp_t=exp_a+exp_c, aatma_t=aatma_a+aatma_c, amft_t=amft_a+amft_c, amjal_t=amjal_a+amjal_c;
 document.getElementById('pe_t').innerText=pe_t;document.getElementById('ft_t').innerText=ft_t;document.getElementById('jal_t').innerText=jal_t;document.getElementById('exp_t').innerText=exp_t;document.getElementById('aatma_t').innerText=aatma_t;document.getElementById('amft_t').innerText=amft_t;document.getElementById('amjal_t').innerText=amjal_t;
 let tot_a=pe_a+ft_a+jal_a+exp_a+aatma_a+amft_a+amjal_a;
 let tot_c=pe_c+ft_c+jal_c+exp_c+aatma_c+amft_c+amjal_c;
 let tot_t=tot_a+tot_c;
 let pe_mtd=n('pe_mtd'),ft_mtd=n('ft_mtd'),jal_mtd=n('jal_mtd'),exp_mtd=n('exp_mtd'),aatma_mtd=n('aatma_mtd'),amft_mtd=n('amft_mtd'),amjal_mtd=n('amjal_mtd');
 let tot_mtd=pe_mtd+ft_mtd+jal_mtd+exp_mtd+aatma_mtd+amft_mtd+amjal_mtd;
 document.getElementById('tot_a').innerText=tot_a;document.getElementById('tot_c').innerText=tot_c;document.getElementById('tot_t').innerText=tot_t;document.getElementById('tot_mtd').innerText=tot_mtd;
 document.getElementById('bar_a').innerText=tot_a;document.getElementById('bar_c').innerText=tot_c;document.getElementById('bar_t').innerText=tot_t;document.getElementById('bar_mtd').innerText=tot_mtd;
 let coll=n('collection');document.getElementById('collShow').innerText=coll.toLocaleString('en-IN');
 let d=document.getElementById('dateInput').value; if(d){let dt=new Date(d);let dd=String(dt.getDate()).padStart(2,'0'),mm=String(dt.getMonth()+1).padStart(2,'0'),yy=dt.getFullYear();document.getElementById('dateShow').innerText=dd+'/'+mm+'/'+yy;}
 return {pe_a,pe_c,pe_t,ft_a,ft_c,ft_t,jal_t,exp_t,aatma_a,aatma_c,aatma_t,amft_a,amft_c,amft_t,amjal_t,tot_a,tot_c,tot_t,tot_mtd,coll}
}
document.querySelectorAll('input').forEach(e=>e.addEventListener('input',()=>{calc();generate();}));
function generate(){
 let d=calc();
 let now=document.getElementById('dateInput').value?new Date(document.getElementById('dateInput').value):new Date();
 let days=["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"];
 let dayName=days[now.getDay()];
 let dd=String(now.getDate()).padStart(2,'0'),mm=String(now.getMonth()+1).padStart(2,'0'),yy=now.getFullYear();
 let nam_form=n('nam_form'),vgn_form=n('vgn_form'),loyalty=n('loyalty'),school=n('school'),google=n('google'),video=n('video'),trip=n('trip');
 let report=`*Today's Operations Summary for ${dayName}  ${dd}/${mm}/${yy}*

Park Entry( *PE* ) = *${d.pe_t}*

Viewing Gallery ( *VG* ) = *${d.ft_t}*

PE + Nij Aatma Manthan ( *NAM* ) = *${d.aatma_t}*

PE + VG + NAM = *${d.amft_t}*

VG + Nij Aatma Abhishek ( *NAA* ) = *${d.jal_t}*

VG + NAM + NAA = *${d.amjal_t}*

VG Express = *${d.exp_t}*

_Total Footfall = *${d.tot_t}*_

* NAM Undertaking Form = *${nam_form}* (Including below 4-year-old kids)

* VG, NAA, NAM Undertaking form = *${vgn_form}* (Including below 4-year-old kids)

Total Loyalty Card = *${loyalty}*

(*Total School Contact* *${school}*

Google Review = *${google}*

Total Video Feedback = *${video}*

Total Trip Advisors = *${trip}*

_Collection: Rs ${d.coll.toLocaleString('en-IN')}_`;
 document.getElementById('report').innerText=report;
}
function copyR(){navigator.clipboard.writeText(document.getElementById('report').innerText).then(()=>alert('Report Copy ho gayi!'));}
document.getElementById('dateInput').valueAsDate=new Date('2026-10-22');calc();generate();
</script>
</body>
</html>
